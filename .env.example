# Weather Alerts Service - Environment Configuration Example
# Copy this file to .env and fill in actual values for your environment

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=development

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Server host and port
API_HOST=0.0.0.0
API_PORT=8000

# API metadata
API_TITLE=Weather Alerts API
API_VERSION=1.0.0

# Enable debug mode (development only)
API_DEBUG=true

# Logging level
API_LOG_LEVEL=INFO

# Default request timeout in seconds
API_REQUEST_TIMEOUT_SECONDS=30

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
# Connection string: postgresql+asyncpg://user:password@host:port/database
DB_URL=postgresql+asyncpg://weather_user:weather_pass@localhost:5432/weather_alerts

# Enable SQLAlchemy SQL echo (debug only)
DB_ECHO=false

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ============================================================================
# REDIS
# ============================================================================
# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# TTL for deduplication keys in seconds (default: 12 hours = 43200)
REDIS_DEDUP_TTL_SECONDS=43200

# Socket timeout in seconds
REDIS_SOCKET_TIMEOUT=5

# ============================================================================
# WEATHER PROVIDER (e.g., OpenWeatherMap)
# ============================================================================
# Replace with actual weather provider API endpoints and credentials
WEATHER_PROVIDER_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_PROVIDER_API_KEY=your-actual-api-key-here

# Request timeout and retry settings
WEATHER_PROVIDER_TIMEOUT_SECONDS=10
WEATHER_PROVIDER_RETRY_ATTEMPTS=3

# ============================================================================
# EMAIL DELIVERY CONFIGURATION
# ============================================================================
# Email provider API URL (e.g., Mailgun, SendGrid, AWS SES)
EMAIL_PROVIDER_URL=https://api.mailgun.net
EMAIL_API_KEY=your-email-provider-api-key

# From address for outgoing notifications
EMAIL_FROM_ADDRESS=alerts@weather-service.local

# Request timeout in seconds
EMAIL_TIMEOUT_SECONDS=10

# ============================================================================
# PUSH NOTIFICATION CONFIGURATION
# ============================================================================
# Push provider API URL (e.g., Firebase Cloud Messaging, OneSignal)
PUSH_PROVIDER_URL=https://api.pushservice.local
PUSH_API_KEY=your-push-provider-api-key

# Request timeout in seconds
PUSH_TIMEOUT_SECONDS=10

# ============================================================================
# WEBHOOK DELIVERY CONFIGURATION
# ============================================================================
# Timeout for webhook HTTP requests
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=30

# Maximum number of retry attempts
WEBHOOK_MAX_RETRIES=5

# Initial backoff duration in seconds (exponential backoff multiplier)
WEBHOOK_RETRY_BACKOFF_SECONDS=1

# ============================================================================
# CELERY TASK QUEUE
# ============================================================================
# Celery broker URL (message queue, typically Redis or RabbitMQ)
CELERY_BROKER_URL=redis://localhost:6379/1

# Celery result backend URL (result storage, typically Redis)
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Track task started state
CELERY_TASK_TRACK_STARTED=true

# Hard time limit for tasks in seconds (1 hour)
CELERY_TASK_TIME_LIMIT=3600

# Soft time limit for tasks in seconds (50 minutes)
CELERY_TASK_SOFT_TIME_LIMIT=3000
