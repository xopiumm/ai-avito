{
	"mcpServers": {
		"context7": {
			"command": "npx",
			"args": [
				"-y",
				"@upstash/context7-mcp"
			],
			"env": {
				"DEFAULT_MINIMUM_TOKENS": ""
			},
			"alwaysAllow": [
				"resolve-library-id",
				"query-docs"
			]
		},
		"filesystem": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"/Users/xopiumm/Desktop/ITMO"
			],
			"alwaysAllow": [
				"read_text_file",
				"read_file",
				"read_media_file",
				"read_multiple_files",
				"write_file",
				"edit_file",
				"create_directory",
				"list_directory",
				"list_directory_with_sizes",
				"directory_tree",
				"move_file"
			]
		},
		"memory": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-memory"
			],
			"alwaysAllow": []
		},
    "todo-mcp": {
			"command": "python",
			"args": [
				"mcp/todo_mcp_server.py"
			]
		}
	}
}